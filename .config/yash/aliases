alias  ..="cd .."
alias ...="cd ../.."

alias la="command -v eza >/dev/null \
    && eza -la --icons --git --time-style='+%b %e %H:%M' \
    || command ls -lAh"

alias ls="command -v eza >/dev/null \
    && eza -a --icons \
    || command ls -Ah"

alias tree="command -v eza >/dev/null \
	&& eza -aT --icons \
	|| command tree -aC"

alias rm="rm -i"
alias rf="rm -rfv"  # not posix-compliant
alias cp="cp -i"

alias df="df -Th"
alias  x="xdg-open"
alias vi="$EDITOR"

alias  s="$(command -v doas || command -v ssu  || command -v sudo) --"
alias se="$(command -v doasedit || printf "s %s" $EDITOR) --"

alias mi="s make clean install"
alias mc="make clean"
alias diff="diff -u --color || diff -u"

alias start_aria='aria2c --conf-path="${XDG_CONFIG_HOME:-$HOME/.config}/aria2/aria2.conf" -D'
alias a2p="aria2p --secret 'aria'"
alias close_aria="pkill -f aria2c"

alias dots='/usr/bin/git -C $DOTS_DIR'  # alias to dots repo

alias gs="git status"
alias gd="git diff --output-indicator-new=' ' --output-indicator-old=' '"
alias gl='git log --graph --all --pretty=format:"%C(magenta)%h %C(white) %an  %ar%C(auto)  %D%n%s%n"'

alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gu="git pull"

alias gb="git branch"
alias gi="git init"
alias gcl="git clone"

alias sft="shfmt -i 4 -ci -sr -p -s"
